{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hada-content-studio://schemas/content/records/0.1.0",
  "title": "HADA Content Studio records",
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,95}$" },
    "series_layout": {
      "type": "object",
      "required": ["orientation", "layout_variation", "additional_shared_elements", "next_page_anticipation"],
      "properties": {
        "orientation": { "enum": ["portrait", "landscape"] },
        "layout_variation": { "enum": ["maximum", "custom"] },
        "layout_variation_details": { "type": "string", "minLength": 1 },
        "additional_shared_elements": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "next_page_anticipation": { "enum": ["required", "optional", "disabled"] }
      },
      "additionalProperties": false
    },
    "female_character_visual_defaults": {
      "type": "object",
      "properties": {
        "age_years": { "type": "integer", "minimum": 1, "maximum": 100 },
        "adult": { "type": "boolean" },
        "presentation": { "type": "string", "minLength": 1 },
        "default_outfit": { "type": "string", "minLength": 1 },
        "pants_allowed_contexts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "outerwear_allowed_contexts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "open_front_outerwear_with_above_knee_skirt": { "type": "boolean" },
        "summer_short_sleeve_target_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "swimming_outfit_default": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "mini_project": {
      "type": "object",
      "required": ["schema_version", "id", "title", "domain", "purpose", "audience", "scope", "visibility", "status"],
      "properties": {
        "schema_version": { "const": "0.1.0" },
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "minLength": 1 },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "purpose": { "type": "string", "minLength": 1 },
        "audience": { "type": "string", "minLength": 1 },
        "scope": { "type": "object", "required": ["includes", "excludes"], "properties": { "includes": { "type": "array", "items": { "type": "string" } }, "excludes": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false },
        "visibility": { "enum": ["private", "internal", "public_safe"] },
        "status": { "enum": ["draft", "active", "paused", "archived"] },
        "knowledge_refs": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "character_refs": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "item_refs": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "production_refs": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "prompt_review_required": { "type": "boolean" },
        "extensions": {
          "type": "object",
          "properties": {
            "content_studio": {
              "type": "object",
              "properties": {
                "series_layout": { "$ref": "#/$defs/series_layout" },
                "character_visual_defaults": {
                  "type": "object",
                  "properties": {
                    "female_character": { "$ref": "#/$defs/female_character_visual_defaults" }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "knowledge_module": {
      "type": "object",
      "required": ["schema_version", "id", "title", "kind", "scope", "status", "claims"],
      "properties": {
        "schema_version": { "const": "0.1.0" },
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["principle", "fact-set", "skill", "procedure", "lesson", "reference"] },
        "scope": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "status": { "enum": ["draft", "review", "approved", "superseded", "archived"] },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "text"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "kind": { "enum": ["source_fact", "user_experience", "user_decision", "inference", "proposal"] },
              "text": { "type": "string", "minLength": 1 },
              "source_refs": { "type": "array", "items": { "$ref": "#/$defs/id" } },
              "verification": { "enum": ["unverified", "checked", "approved"] }
            },
            "additionalProperties": false
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "locator", "rights"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "locator": { "type": "string", "minLength": 1 },
              "retrieved_at": { "type": "string" },
              "relevant_location": { "type": "string" },
              "rights": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "extensions": { "type": "object" }
      },
      "additionalProperties": false
    },
    "infographic_production": {
      "type": "object",
      "required": ["schema_version", "id", "project_id", "title", "status", "profile_id", "knowledge_refs"],
      "properties": {
        "schema_version": { "const": "0.1.0" },
        "id": { "$ref": "#/$defs/id" },
        "project_id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "enum": ["draft", "review", "approved", "published", "archived"] },
        "profile_id": { "$ref": "#/$defs/id" },
        "knowledge_refs": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "character_refs": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "item_refs": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "asset_refs": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "extensions": { "type": "object" }
      },
      "additionalProperties": false
    },
    "prompt_review": {
      "type": "object",
      "required": ["schema_version", "id", "work_id", "work_kind", "status", "brief_path", "brief_sha256", "prompt_resolution_id", "passing_score", "score_max", "max_candidates", "rubric", "candidates", "selected_candidate_id", "selected_prompt_path", "selected_prompt_sha256", "selection_reason"],
      "properties": {
        "schema_version": { "const": "0.1.0" },
        "id": { "$ref": "#/$defs/id" },
        "work_id": { "$ref": "#/$defs/id" },
        "work_kind": { "type": "string", "minLength": 1 },
        "status": { "enum": ["in_progress", "selected_pass", "selected_below_threshold", "halted_model_change", "halted_evaluator_unavailable"] },
        "brief_path": { "type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+" },
        "brief_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "prompt_resolution_id": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9._-]{1,95}$" },
        "halt_reason": { "type": "string", "minLength": 1 },
        "passing_score": { "const": 90 },
        "score_max": { "const": 100 },
        "max_candidates": { "const": 5 },
        "rubric": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["id", "label", "weight"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "label": { "type": "string", "minLength": 1 },
              "weight": { "type": "integer", "minimum": 1, "maximum": 100 }
            },
            "additionalProperties": false
          }
        },
        "candidates": {
          "type": "array", "minItems": 1, "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["id", "number", "exact_prompt", "prompt_sha256", "total_score", "raw_score", "revision_of", "addressed_findings", "changes", "criteria", "critical_checks", "unsupported_assumption_count", "evaluator", "reviewed_at"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "number": { "type": "integer", "minimum": 1, "maximum": 5 },
              "exact_prompt": { "type": "string", "minLength": 1 },
              "prompt_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
              "total_score": { "type": "integer", "minimum": 0, "maximum": 100 },
              "raw_score": { "type": "integer", "minimum": 0, "maximum": 100 },
              "revision_of": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9._-]{1,95}$" },
              "addressed_findings": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
              "changes": {
                "type": "array",
                "items": {
                  "type": "object", "required": ["finding_id", "change"],
                  "properties": {
                    "finding_id": { "$ref": "#/$defs/id" },
                    "change": { "type": "string", "minLength": 1 }
                  },
                  "additionalProperties": false
                }
              },
              "criteria": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object", "required": ["criterion_id", "points", "evidence"],
                  "properties": {
                    "criterion_id": { "$ref": "#/$defs/id" },
                    "points": { "type": "integer", "minimum": 0, "maximum": 100 },
                    "evidence": { "type": "string", "minLength": 1 },
                    "finding_id": { "$ref": "#/$defs/id" },
                    "finding": { "type": "string", "minLength": 1 }
                  },
                  "additionalProperties": false
                }
              },
              "critical_checks": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object", "required": ["id", "passed", "evidence"],
                  "properties": {
                    "id": { "$ref": "#/$defs/id" },
                    "passed": { "type": "boolean" },
                    "evidence": { "type": "string", "minLength": 1 },
                    "finding_id": { "$ref": "#/$defs/id" },
                    "finding": { "type": "string", "minLength": 1 }
                  },
                  "additionalProperties": false
                }
              },
              "unsupported_assumption_count": { "type": "integer", "minimum": 0 },
              "evaluator": {
                "type": "object", "required": ["provider", "api_model_id", "displayed_model_name", "reasoning_strength"],
                "properties": {
                  "provider": { "type": "string", "minLength": 1 },
                  "api_model_id": { "type": "string", "minLength": 1 },
                  "displayed_model_name": { "type": "string", "minLength": 1 },
                  "reasoning_strength": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              },
              "reviewed_at": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "selected_candidate_id": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9._-]{1,95}$" },
        "selected_prompt_path": { "type": ["string", "null"], "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+" },
        "selected_prompt_sha256": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
        "selection_reason": { "type": "string", "minLength": 1 },
        "observed_evaluator": {
          "type": "object", "required": ["provider", "api_model_id", "displayed_model_name", "reasoning_strength"],
          "properties": {
            "provider": { "type": "string", "minLength": 1 },
            "api_model_id": { "type": "string", "minLength": 1 },
            "displayed_model_name": { "type": "string", "minLength": 1 },
            "reasoning_strength": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "publication_record": {
      "type": "object",
      "required": ["schema_version", "id", "production_id", "asset_id", "derivative_id", "derivative_path", "destination", "published_at", "derivative_sha256", "profile_version"],
      "properties": {
        "schema_version": { "const": "0.1.0" },
        "id": { "$ref": "#/$defs/id" },
        "production_id": { "$ref": "#/$defs/id" },
        "asset_id": { "$ref": "#/$defs/id" },
        "derivative_id": { "$ref": "#/$defs/id" },
        "derivative_path": { "type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+" },
        "destination": { "type": "string", "minLength": 1 },
        "public_url": { "type": "string" },
        "published_at": { "type": "string", "minLength": 1 },
        "derivative_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "profile_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "extensions": { "type": "object" }
      },
      "additionalProperties": false
    }
  }
}
